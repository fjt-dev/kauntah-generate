---
import BaseLayout from "../layouts/BaseLayout.astro";
import { digitImages, type ThemeName } from "../data/digitImages";

interface Props {
  locale: "en" | "ja";
}

const { locale } = Astro.props;
const isJa = locale === "ja";
const themeNames: ThemeName[] = ["normal-150", "blue2-150", "green-100", "blue2-100"];
const initialTheme: ThemeName = "normal-150";
const rule34Images = Array.from({ length: 10 }, (_, digit) => `/images/rule34/${digit}.gif`);
const endpoint = "https://counter.fjtd.dev/counter";

const copy = isJa
  ? {
      title: "Kauntah ジェネレーター",
      description: "貼るだけで使えるレトロなアクセスカウンターを作成します。",
      home: "Kauntahジェネレーター ホーム",
      brand: "Kauntah Generator",
      nav: "メインナビゲーション",
      language: "言語",
      github: "GitHub ↗",
      eyebrow: "ACCESS COUNTER GENERATOR",
      pageTitle: "Kauntahを作る。",
      introduction: "デザインを選び、必要な値だけを設定してURLを生成します。アカウントもカウンターIDも必要ありません。",
      designsTitle: "デザイン一覧",
      designsDescription: "使用するカウンターのテーマを選択します。",
      chooseTheme: "このデザインを選択",
      selectedTheme: "選択中",
      generatorTitle: "ジェネレーター",
      generatorDescription: "プレビューを確認し、カウンター用URLを生成します。",
      customize: "カウンターを設定",
      param: "パラメータ",
      paramDescription: "説明",
      paramValue: "値",
      theme: "テーマ",
      themeDescription: "カウンター画像のテーマを選択します。",
      animation: "アニメーション",
      animationDescription: "blue2-100専用です。動きのあるrule34版に切り替えます。",
      animationNone: "なし（静止画）",
      animationRule34: "あり（rule34）",
      offset: "初期加算値",
      offsetDescription: "カウントに加算する初期値です。0〜1,000,000。",
      offsetError: "0〜1,000,000の整数を入力してください。",
      padding: "最小表示桁数",
      paddingDescription: "左側を0で埋める最小桁数です。任意で1〜16。",
      paddingError: "1〜16の整数を入力してください。",
      preview: "生成されるカウンターのプレビュー",
      generate: "URLを生成",
      generatedUrl: "生成URL",
      copyUrl: "URLをコピー",
      copied: "コピーしました",
      selected: "選択しました",
      noIdTitle: "カウンターIDは不要です。",
      noIdBody: "Kauntahが設置先のドメインを識別し、サイトごとに独立したカウントを保存します。",
      footer: "Kauntah — 貼るだけのアクセスカウンター。",
    }
  : {
      title: "Kauntah Generator",
      description: "Create a delightfully simple retro access counter for your website.",
      home: "Kauntah Generator home",
      brand: "Kauntah Generator",
      nav: "Main navigation",
      language: "Language",
      github: "GitHub ↗",
      eyebrow: "ACCESS COUNTER GENERATOR",
      pageTitle: "Make your Kauntah.",
      introduction: "Choose a design, set only the values you need, and generate a counter URL. No account or counter ID is required.",
      designsTitle: "Designs",
      designsDescription: "Choose the image theme used by your counter.",
      chooseTheme: "Choose this design",
      selectedTheme: "Selected",
      generatorTitle: "Generator",
      generatorDescription: "Check the preview and generate the URL for your counter.",
      customize: "Customize your counter",
      param: "Param",
      paramDescription: "Description",
      paramValue: "Value",
      theme: "Theme",
      themeDescription: "Select the image theme used by the counter.",
      animation: "Animation",
      animationDescription: "Available for blue2-100 only. Switch to the animated rule34 version.",
      animationNone: "None (static)",
      animationRule34: "On (rule34)",
      offset: "Starting offset",
      offsetDescription: "Add a starting value to the counter, from 0 to 1,000,000.",
      offsetError: "Enter a whole number from 0 to 1,000,000.",
      padding: "Minimum display digits",
      paddingDescription: "Pad the display with leading zeros. Optional, from 1 to 16.",
      paddingError: "Enter a whole number from 1 to 16.",
      preview: "Preview of the generated counter",
      generate: "Generate URL",
      generatedUrl: "Generated URL",
      copyUrl: "Copy URL",
      copied: "Copied!",
      selected: "Selected",
      noIdTitle: "No counter ID required.",
      noIdBody: "Kauntah identifies the host website and keeps a separate count for every domain.",
      footer: "Kauntah — a delightfully simple access counter.",
    };
---

<BaseLayout lang={locale} title={copy.title} description={copy.description}>
  <header class="shell site-header">
    <a class="brand" href="#top" aria-label={copy.home}>{copy.brand}</a>
    <nav class="site-nav" aria-label={copy.nav}>
      <a href="https://counter.fjtd.dev/">{copy.github}</a>
      <span class="language-switch" aria-label={copy.language}>
        <a href="/" lang="en" aria-current={!isJa ? "page" : undefined}>EN</a>
        <a href="/ja/" lang="ja" aria-current={isJa ? "page" : undefined}>日本語</a>
      </span>
    </nav>
  </header>

  <main class="shell page" id="top">
    <section class="intro" aria-labelledby="page-title">
      <p class="eyebrow">{copy.eyebrow}</p>
      <h1 id="page-title">{copy.pageTitle}</h1>
      <p>{copy.introduction}</p>
    </section>

    <section class="page-section" aria-labelledby="designs-title">
      <div class="section-heading">
        <h2 id="designs-title">{copy.designsTitle}</h2>
        <p>{copy.designsDescription}</p>
      </div>

      <div class="design-list">
        {themeNames.map((theme) => (
          <button class="design-card" type="button" data-theme={theme} aria-label={`${copy.chooseTheme}: ${theme}`} aria-pressed={theme === initialTheme ? "true" : "false"}>
            <span class="design-card-heading">
              <strong>{theme}</strong>
              <span data-theme-status>{theme === initialTheme ? copy.selectedTheme : copy.chooseTheme}</span>
            </span>
            <span class="design-strip" aria-hidden="true">
              {digitImages[theme].map((src) => <img src={src} alt="" loading="lazy" />)}
            </span>
          </button>
        ))}
      </div>
    </section>

    <section class="page-section" id="generator" aria-labelledby="generator-title">
      <div class="section-heading">
        <h2 id="generator-title">{copy.generatorTitle}</h2>
        <p>{copy.generatorDescription}</p>
      </div>

      <div class="generator">
        <form class="settings" id="settings">
          <h3 class="panel-title"><span class="step">1</span>{copy.customize}</h3>

          <div class="mini-preview" aria-live="polite">
            <div class="counter-strip" data-digit-strip aria-label={copy.preview}>
              <img src={digitImages[initialTheme][1]} alt="1" />
            </div>
          </div>

          <div class="parameter-table">
            <div class="parameter-head" aria-hidden="true">
              <span>{copy.param}</span>
              <span>{copy.paramDescription}</span>
              <span>{copy.paramValue}</span>
            </div>

            <div class="parameter-row">
              <label class="parameter-name" for="asset"><code>asset</code></label>
              <p class="parameter-description">{copy.themeDescription}</p>
              <div class="parameter-control">
                <select id="asset" name="asset" aria-label={copy.theme}>
                  {themeNames.map((theme) => <option value={theme}>{theme}</option>)}
                </select>
              </div>
            </div>

            <div class="parameter-row">
              <label class="parameter-name" for="animation"><code>animation</code></label>
              <p class="parameter-description" id="animation-help">{copy.animationDescription}</p>
              <div class="parameter-control">
                <select id="animation" name="animation" aria-label={copy.animation} aria-describedby="animation-help" disabled>
                  <option value="0">{copy.animationNone}</option>
                  <option value="1">{copy.animationRule34}</option>
                </select>
              </div>
            </div>

            <div class="parameter-row">
              <label class="parameter-name" for="offset"><code>offset</code></label>
              <p class="parameter-description" id="offset-help">{copy.offsetDescription}</p>
              <div class="parameter-control">
                <input id="offset" name="offset" type="number" min="0" max="1000000" step="1" value="0" inputmode="numeric" aria-label={copy.offset} aria-describedby="offset-help offset-error" />
                <span class="field-error" id="offset-error" role="alert" hidden>{copy.offsetError}</span>
              </div>
            </div>

            <div class="parameter-row">
              <label class="parameter-name" for="padding"><code>padding</code></label>
              <p class="parameter-description" id="padding-help">{copy.paddingDescription}</p>
              <div class="parameter-control">
                <input id="padding" name="padding" type="number" min="1" max="16" step="1" inputmode="numeric" aria-label={copy.padding} aria-describedby="padding-help padding-error" />
                <span class="field-error" id="padding-error" role="alert" hidden>{copy.paddingError}</span>
              </div>
            </div>
          </div>

          <button class="button button-primary generate" type="submit">{copy.generate}</button>
        </form>

        <div class="output">
          <h3 class="panel-title"><span class="step">2</span>{copy.generatedUrl}</h3>
          <div class="code-wrap" id="result" hidden>
            <pre id="code" tabindex="0"></pre>
            <button class="copy" id="copy" type="button">{copy.copyUrl}</button>
          </div>
          <div class="notice">
            <span aria-hidden="true">✦</span>
            <div><strong>{copy.noIdTitle}</strong><br />{copy.noIdBody}</div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="shell site-footer">
    <span>{copy.footer}</span>
    <a href="https://counter.fjtd.dev/">{copy.github}</a>
  </footer>

  <script is:inline define:vars={{ digitImages, rule34Images, endpoint, copyLabels: { copy: copy.copyUrl, copied: copy.copied, selected: copy.selected, chooseTheme: copy.chooseTheme, selectedTheme: copy.selectedTheme } }}>
    const asset = document.querySelector("#asset");
    const animation = document.querySelector("#animation");
    const offset = document.querySelector("#offset");
    const offsetError = document.querySelector("#offset-error");
    const padding = document.querySelector("#padding");
    const paddingError = document.querySelector("#padding-error");
    const code = document.querySelector("#code");
    const result = document.querySelector("#result");
    const copyButton = document.querySelector("#copy");
    const digitStrip = document.querySelector("[data-digit-strip]");
    const themeButtons = [...document.querySelectorAll("[data-theme]")];

    function offsetValue() {
      return Math.max(0, Math.min(1000000, Number(offset.value) || 0));
    }

    function updateOffsetError() {
      const invalid = offset.value !== "" && !offset.checkValidity();
      offsetError.hidden = !invalid;
      offset.setAttribute("aria-invalid", String(invalid));
      return !invalid;
    }

    function paddingValue() {
      const value = Number(padding.value);
      return Number.isInteger(value) && value >= 1 && value <= 16 ? value : 0;
    }

    function updatePaddingError() {
      const invalid = padding.value !== "" && !padding.checkValidity();
      paddingError.hidden = !invalid;
      padding.setAttribute("aria-invalid", String(invalid));
      return !invalid;
    }

    function animationEnabled() {
      return asset.value === "blue2-100" && animation.value === "1";
    }

    function counterUrl() {
      const params = new URLSearchParams();
      if (asset.value !== "normal-150") params.set("asset", asset.value);
      if (animationEnabled()) params.set("animation", "1");
      const initial = offsetValue();
      if (initial) params.set("offset", String(initial));
      const minimumDigits = paddingValue();
      if (minimumDigits) params.set("padding", String(minimumDigits));
      return endpoint + (params.size ? `?${params.toString()}` : "");
    }

    function makeDigitImage(src, digit) {
      const image = document.createElement("img");
      image.src = src;
      image.alt = String(digit);
      return image;
    }

    function updateThemeSelection() {
      themeButtons.forEach((button) => {
        const selected = button.dataset.theme === asset.value;
        button.setAttribute("aria-pressed", String(selected));
        button.querySelector("[data-theme-status]").textContent = selected ? copyLabels.selectedTheme : copyLabels.chooseTheme;
      });
    }

    function renderPreview() {
      animation.disabled = asset.value !== "blue2-100";
      if (animation.disabled) animation.value = "0";
      const images = animationEnabled() ? rule34Images : digitImages[asset.value];
      const previewValue = String(offsetValue() + 1).padStart(paddingValue(), "0");
      digitStrip.replaceChildren(...[...previewValue].map((digit) => makeDigitImage(images[Number(digit)], digit)));
      updateThemeSelection();
    }

    function resetResult() {
      result.hidden = true;
      copyButton.textContent = copyLabels.copy;
    }

    themeButtons.forEach((button) => button.addEventListener("click", () => {
      asset.value = button.dataset.theme;
      renderPreview();
      resetResult();
    }));

    [asset, animation, offset, padding].forEach((control) => control.addEventListener("input", () => {
      renderPreview();
      resetResult();
    }));

    padding.addEventListener("input", updatePaddingError);
    padding.addEventListener("invalid", (event) => {
      event.preventDefault();
      updatePaddingError();
    });
    offset.addEventListener("input", updateOffsetError);
    offset.addEventListener("invalid", (event) => {
      event.preventDefault();
      updateOffsetError();
    });

    copyButton.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(code.textContent);
        copyButton.textContent = copyLabels.copied;
        setTimeout(() => { copyButton.textContent = copyLabels.copy; }, 1300);
      } catch {
        const selection = window.getSelection();
        const range = document.createRange();
        range.selectNodeContents(code);
        selection.removeAllRanges();
        selection.addRange(range);
        copyButton.textContent = copyLabels.selected;
      }
    });

    code.addEventListener("click", () => {
      const range = document.createRange();
      range.selectNodeContents(code);
      const selection = window.getSelection();
      selection.removeAllRanges();
      selection.addRange(range);
    });

    renderPreview();

    document.querySelector("#settings").addEventListener("submit", (event) => {
      event.preventDefault();
      if (!updateOffsetError() || !updatePaddingError()) return;
      code.textContent = counterUrl();
      result.hidden = false;
    });
  </script>
</BaseLayout>
