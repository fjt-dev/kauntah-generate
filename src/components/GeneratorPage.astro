---
import BaseLayout from "../layouts/BaseLayout.astro";
import ExternalLinkIcon from "./ExternalLinkIcon.astro";
import { digitImages } from "../data/digitImages";
import { themes, embedCode, type Theme } from "../lib/generator";

interface Props { locale: "en" | "ja"; }
const { locale } = Astro.props;
const isJa = locale === "ja";
const initial = { asset: "normal-150" as Theme, offset: 0, padding: 0 };
const copy = isJa ? {
  commandTrain: "SLが通過します。Escで終了。", commandUuidCopyError: "コピーできませんでした。表示されたUUIDを選択してコピーしてください。", commandCat: "猫が現れました。にゃー。", commandMode: "コマンド操作（Beta）", commandInput: "コマンド", commandRun: "実行", commandComplete: "補完", commandCandidates: "補完候補", commandCompletionCount: "件の候補", commandLog: "コマンド実行履歴",
  commandHelp: "Tab: 補完 · ↑/↓: 履歴 · Ctrl+C: 取消 · Ctrl+L: 消去 · Esc: 候補を閉じる · Shift+Tab: 戻る",
  commandIntro: "kauntah --asset rule34 --padding 6\nhelp / themes / show / copy / reset / clear / history",
  commandUsage: "kauntah [--asset NAME] [--offset 0–1000000] [--padding 1–16|auto] [--format html|url]\ntheme NAME / offset NUMBER / padding NUMBER|auto / format html|url\nthemes  デザイン一覧\nshow    現在の設定とコード\ncopy    現在の形式でコピー\nreset   設定を初期化\nclear   表示履歴を消去\nhistory 入力履歴を表示\nTab     コマンド・オプション・値を補完\n↑ / ↓   入力履歴\nCtrl+A/E  行頭/行末へ移動\nCtrl+U/K  カーソル前/後を削除\nCtrl+C    入力取消\nCtrl+L    表示を消去（入力は保持）\nEsc       補完候補を閉じる\nShift+Tab 前の操作へ移動",
  commandInvalid: "設定欄の入力エラーを修正してください。", commandCleared: "表示履歴を消去しました。",
  commandErrors: { unknownCommand: "不明なコマンドです。help で一覧を確認してください。", unknownOption: "不明なオプション、または余分な引数があります。help で使い方を確認してください。", missingValue: "設定値を指定してください。", duplicateOption: "同じオプションを複数回指定できません。", invalidTheme: "デザイン名が無効です。themes で一覧を確認してください。", invalidOffset: "offset は0〜1,000,000の整数で指定してください。", invalidPadding: "padding は1〜16の整数、または auto で指定してください。", invalidFormat: "format は html または url で指定してください。", tooLong: "コマンドは1,024文字以内で入力してください。" },
  skip: "本文へ移動", newWindow: "新しいタブで開きます", title: "Kauntah ジェネレーター", home: "Kauntah ジェネレーター ホーム", language: "言語", nav: "ナビゲーション",
  description: "Kauntahのデザインと表示を設定し、サイトに設置するHTMLをコピーできます。",
  settings: "設定", theme: "デザイン", offset: "カウントへの加算値", padding: "最小表示桁数", auto: "指定なし",
  offsetHelp: "実際のカウントに加算して表示します。保存済みのカウントは変わりません。",
  paddingHelp: "指定した桁数まで左側を0で埋めます。空欄の場合はゼロ埋めしません。",
  offsetError: "0〜1,000,000の整数を入力してください。", paddingError: "1〜16の整数を入力するか、空欄にしてください。",
  preview: "プレビュー", previewHelp: "未計測（0件）に加算値を反映した表示です。プレビューではカウントされません。", previewInvalid: "入力内容を確認してください。",
  embed: "設置コード", html: "HTML", url: "画像URL", copy: "コピー", copied: "コピーしました", selected: "コードを選択しました。手動でコピーしてください。",
  htmlHelp: "設置先ページのHTMLに貼り付けてください。", urlHelp: "画像URLを直接開いてもカウントされません。設置時はRefererの送信が必要です。",
  invalid: "入力エラーを修正すると、設置コードが表示されます。",
  usage: "仕様・設置方法", referer: "カウントは設置先のホスト名ごとに保存されます。サブドメインが違う場合は別のカウンターです。IDの設定は不要です。",
  policy: "HTMLの referrerpolicy=\"origin\" は削除しないでください。Refererが送信されない環境ではカウントされません。画像プロキシやMarkdownの表示環境によっては利用できません。",
  limit: "同じホスト・同じIPからの加算は60秒間に最大20回です。画像の読み込み回数を数えるため、ユニーク訪問者数ではありません。",
  docs: "仕様を読む", credits: "素材・利用条件", alt: "アクセスカウンター", noScript: "設定の変更にはJavaScriptを有効にしてください。初期設定のHTMLはそのままコピーして利用できます。",
} : {
  commandTrain: "SL is passing. Press Esc to dismiss.", commandUuidCopyError: "Copy failed. Select and copy the generated UUID manually.", commandCat: "A cat appears and says meow.", commandMode: "Command mode (Beta)", commandInput: "Command", commandRun: "Run", commandComplete: "Complete", commandCandidates: "Completions", commandCompletionCount: " candidates", commandLog: "Command history",
  commandHelp: "Tab: complete · ↑/↓: history · Ctrl+C: cancel · Ctrl+L: clear · Esc: dismiss · Shift+Tab: back",
  commandIntro: "kauntah --asset rule34 --padding 6\nhelp / themes / show / copy / reset / clear / history",
  commandUsage: "kauntah [--asset NAME] [--offset 0–1000000] [--padding 1–16|auto] [--format html|url]\ntheme NAME / offset NUMBER / padding NUMBER|auto / format html|url\nthemes  List designs\nshow    Show current settings and code\ncopy    Copy the current format\nreset   Restore default settings\nclear   Clear displayed history\nhistory Show input history\nTab     Complete commands, options, and values\n↑ / ↓   Input history\nCtrl+A/E  Move to start/end\nCtrl+U/K  Delete before/after cursor\nCtrl+C    Cancel input\nCtrl+L    Clear output, keep input\nEsc       Dismiss completions\nShift+Tab Move to previous control",
  commandInvalid: "Fix the invalid values in Settings first.", commandCleared: "Display history cleared.",
  commandErrors: { unknownCommand: "Unknown command. Type help for available commands.", unknownOption: "Unknown option or extra argument. Type help for usage.", missingValue: "Provide a value for the setting.", duplicateOption: "Each option may only appear once.", invalidTheme: "Unknown design. Type themes for available designs.", invalidOffset: "offset must be a whole number from 0 to 1,000,000.", invalidPadding: "padding must be a whole number from 1 to 16, or auto.", invalidFormat: "format must be html or url.", tooLong: "Commands must be 1,024 characters or fewer." },
  skip: "Skip to content", newWindow: "Opens in a new tab", title: "Kauntah Generator", home: "Kauntah Generator home", language: "Language", nav: "Navigation",
  description: "Configure a Kauntah counter and copy the HTML for your website.",
  settings: "Settings", theme: "Design", offset: "Count offset", padding: "Minimum digits", auto: "None",
  offsetHelp: "Added to the displayed count. This does not change the stored count.",
  paddingHelp: "Pad with leading zeros to this number of digits. Leave blank for no padding.",
  offsetError: "Enter a whole number from 0 to 1,000,000.", paddingError: "Enter a whole number from 1 to 16, or leave blank.",
  preview: "Preview", previewHelp: "Zero recorded hits plus your offset. This preview never increases the count.", previewInvalid: "Check the values in Settings.",
  embed: "Embed code", html: "HTML", url: "Image URL", copy: "Copy", copied: "Copied", selected: "Code selected. Please copy it manually.",
  htmlHelp: "Paste this into your website’s HTML.", urlHelp: "Opening the image URL directly does not count a hit. An embedding page must send a Referer.",
  invalid: "Fix the input errors to see your embed code.",
  usage: "Usage & specifications", referer: "Counts are stored per hostname. Subdomains have separate counters. No counter ID is needed.",
  policy: "Keep referrerpolicy=\"origin\" in the HTML. Without a Referer, hits are not counted. Image proxies and some Markdown environments may not work.",
  limit: "A host and IP combination can increment up to 20 times per 60 seconds. This counts image requests, not unique visitors.",
  docs: "Documentation", credits: "Artwork & usage terms", alt: "Visitor counter", noScript: "Enable JavaScript to change settings. You can still copy and use the default HTML below.",
};
const themeNames = Object.keys(themes) as Theme[];
---
<BaseLayout lang={locale} title={copy.title} description={copy.description}>
  <a class="skip-link" href="#main-content">{copy.skip}</a>
  <header class="site-header"><div class="shell header-inner">
    <a class="brand" href={isJa ? "/ja/" : "/"} aria-label={copy.home}>Kauntah</a>
    <nav aria-label={copy.nav}>
      <a href="https://github.com/fjt-dev/Kauntah" target="_blank" rel="noreferrer" class="external-link">GitHub<ExternalLinkIcon /><span class="sr-only"> ({copy.newWindow})</span></a>
      <div class="language-switch" role="group" aria-label={copy.language}>
        <a href="/" lang="en" aria-current={!isJa ? "page" : undefined}>EN</a>
        <a href="/ja/" lang="ja" aria-current={isJa ? "page" : undefined}>日本語</a>
      </div>
    </nav>
  </div></header>
  <main class="shell page" id="main-content" tabindex="-1">
    <h1>{copy.title}</h1>
    <noscript><p class="notice">{copy.noScript}</p></noscript>
    <div class="workspace">
        <section class="preview-section" aria-labelledby="preview-title">
          <div class="section-heading"><h2 id="preview-title">{copy.preview}</h2><span id="image-size">68 × 150 px</span></div>
          <div class="preview-stage" id="preview-stage">
            <div class="counter-strip" data-digit-strip role="img" aria-label={`${copy.preview}: 0`} style="--digit-count: 1; --digit-width: 68px;">
              <img src={digitImages[initial.asset][0]} alt="" width="68" height="150" />
            </div>
          </div>
          <p class="field-help" id="preview-help">{copy.previewHelp}</p>
        </section>
      <section class="settings" aria-labelledby="settings-title">
        <h2 id="settings-title">{copy.settings}</h2>
        <details class="command-console" id="command-console">
          <summary>{copy.commandMode}</summary>
          <div class="command-terminal">
            <div class="terminal-title" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="m4 6 6 6-6 6M12 18h8" /></svg><span>guest@kauntah: ~</span></div>
            <div id="command-log" class="command-log" role="log" aria-label={copy.commandLog} aria-live="polite" aria-relevant="additions" tabindex="0"><pre class="command-intro">{copy.commandIntro}</pre></div>
            <form id="command-form" class="command-form">
              <label for="command-input" class="sr-only">{copy.commandInput}</label>
              <span class="command-prompt" aria-hidden="true"><span class="shell-user">guest@kauntah</span>:<span class="shell-path">~</span>$</span>
              <input id="command-input" name="command" type="text" maxlength="1024" autocomplete="off" autocapitalize="off" spellcheck="false" aria-describedby="command-help" aria-controls="command-completions" />
              <div class="command-actions"><button type="button" id="command-complete">{copy.commandComplete}</button><button type="submit">{copy.commandRun}</button></div>
            </form>
            <div id="command-completions" class="command-completions" role="group" aria-label={copy.commandCandidates} hidden></div>
            <p id="command-completion-status" class="sr-only" role="status"></p>
          </div>
          <p id="command-help" class="field-help">{copy.commandHelp}</p>
        </details>
        <form id="settings" aria-labelledby="settings-title" novalidate>
        <fieldset class="theme-picker">
          <legend>{copy.theme}</legend>
          <div class="theme-list">
            {themeNames.map(theme => <label class="theme-option">
              <input type="radio" name="asset" value={theme} checked={theme === initial.asset} />
              <span class="theme-name">{theme}</span>
              <span class="theme-sample" aria-hidden="true">{[0, 1, 2].map(digit => <img src={digitImages[theme][digit]} alt="" width={themes[theme].width} height={themes[theme].height} />)}</span>
            </label>)}
          </div>
        </fieldset>
        <div class="field">
          <div class="field-heading"><label for="offset">{copy.offset}</label><span>0–1,000,000</span></div>
          <input id="offset" name="offset" type="number" min="0" max="1000000" step="1" value="0" inputmode="numeric" aria-describedby="offset-help" />
          <p id="offset-help" class="field-help">{copy.offsetHelp}</p>
          <p class="field-error" id="offset-error" hidden>{copy.offsetError}</p>
        </div>
        <div class="field">
          <div class="field-heading"><label for="padding">{copy.padding}</label><span>1–16</span></div>
          <input id="padding" name="padding" type="number" min="1" max="16" step="1" inputmode="numeric" placeholder={copy.auto} aria-describedby="padding-help" />
          <p id="padding-help" class="field-help">{copy.paddingHelp}</p>
          <p class="field-error" id="padding-error" hidden>{copy.paddingError}</p>
        </div>
        </form>
      </section>
        <section class="embed-section" aria-labelledby="embed-title">
          <div class="section-heading"><h2 id="embed-title">{copy.embed}</h2><button class="copy-button" id="copy" type="button">{copy.copy}</button></div>
          <div class="format-switch" role="tablist" aria-label={copy.embed}>
            <button type="button" id="format-html" role="tab" data-format="html" aria-selected="true" aria-controls="code-panel" tabindex="0">{copy.html}</button>
            <button type="button" id="format-url" role="tab" data-format="url" aria-selected="false" aria-controls="code-panel" tabindex="-1">{copy.url}</button>
          </div>
          <div id="code-panel" role="tabpanel" aria-labelledby="format-html" tabindex="0">
            <pre id="code">{embedCode(initial, "html", copy.alt)}</pre>
            <p id="invalid-code" class="field-error" hidden>{copy.invalid}</p>
            <p class="field-help" id="format-help">{copy.htmlHelp}</p>
          </div>
          <p id="copy-status" role="status" class="status"></p>
        </section>
        <details class="usage">
          <summary>{copy.usage}</summary>
          <ul><li>{copy.referer}</li><li>{copy.policy}</li><li>{copy.limit}</li></ul>
          <a href={`https://github.com/fjt-dev/Kauntah/blob/main/${isJa ? "README.ja.md" : "README.md"}`} target="_blank" rel="noreferrer" class="external-link">{copy.docs}<ExternalLinkIcon /><span class="sr-only"> ({copy.newWindow})</span></a>
        </details>
    </div>
    <p id="validation-status" class="sr-only" role="status" aria-atomic="true"></p>
  </main>
  <footer class="shell site-footer"><span>Kauntah</span><a href="https://github.com/fjt-dev/Kauntah#credits" target="_blank" rel="noreferrer" class="external-link">{copy.credits}<ExternalLinkIcon /><span class="sr-only"> ({copy.newWindow})</span></a></footer>
  <script id="generator-labels" type="application/json" is:inline set:html={JSON.stringify(copy).replaceAll("<", "\\u003c")} />
  <script>
    import { digitImages } from "../data/digitImages";
    import { runSteamTrain } from "../lib/steam-train";
    import { completeCommand, insertCompletion } from "../lib/completion";
    import { parseCommand, describeCommandState, type CommandState } from "../lib/commands";
    import { themes, validateSettings, previewDigits, embedCode, type Format } from "../lib/generator";

    const labels = JSON.parse(document.querySelector("#generator-labels")!.textContent!);
    const form = document.querySelector<HTMLFormElement>("#settings")!;
    const offset = document.querySelector<HTMLInputElement>("#offset")!;
    const padding = document.querySelector<HTMLInputElement>("#padding")!;
    const code = document.querySelector<HTMLElement>("#code")!;
    const strip = document.querySelector<HTMLElement>("[data-digit-strip]")!;
    const copyButton = document.querySelector<HTMLButtonElement>("#copy")!;
    const status = document.querySelector<HTMLElement>("#copy-status")!;
    const validationStatus = document.querySelector<HTMLElement>("#validation-status")!;
    const panel = document.querySelector<HTMLElement>("#code-panel")!;
    const formatButtons = [...document.querySelectorAll<HTMLButtonElement>("[data-format]")];
    let format: Format = "html";
    let revision = 0;
    let timer: ReturnType<typeof setTimeout>;

    function render() {
      revision++;
      clearTimeout(timer);
      copyButton.textContent = labels.copy;
      status.textContent = "";
      const asset = form.querySelector<HTMLInputElement>('[name="asset"]:checked')!.value;
      const result = validateSettings(asset, offset.value, padding.value);
      const errors = { offset: result.errors.offset || offset.validity.badInput, padding: result.errors.padding || padding.validity.badInput };
      [offset, padding].forEach(control => {
        const invalid = errors[control.id as "offset" | "padding"];
        control.setAttribute("aria-invalid", String(invalid));
        control.setAttribute("aria-describedby", `${control.id}-help${invalid ? ` ${control.id}-error` : ""}`);
        document.querySelector<HTMLElement>(`#${control.id}-error`)!.hidden = !invalid;
      });
      const errorText = [errors.offset ? labels.offsetError : "", errors.padding ? labels.paddingError : ""].filter(Boolean).join(" ");
      if (validationStatus.textContent !== errorText) validationStatus.textContent = errorText;
      const valid = result.valid && !errors.offset && !errors.padding;
      copyButton.disabled = !valid;
      code.hidden = !valid;
      document.querySelector<HTMLElement>("#invalid-code")!.hidden = valid;
      document.querySelector<HTMLElement>("#preview-stage")!.hidden = !valid;
      document.querySelector<HTMLElement>("#preview-help")!.textContent = valid ? labels.previewHelp : labels.previewInvalid;
      document.querySelector<HTMLElement>("#format-help")!.textContent = valid ? labels[format + "Help"] : "";
      const size = document.querySelector<HTMLElement>("#image-size")!;
      size.hidden = !valid;
      formatButtons.forEach(button => {
        const selected = button.dataset.format === format;
        button.setAttribute("aria-selected", String(selected));
        button.tabIndex = selected ? 0 : -1;
      });
      panel.setAttribute("aria-labelledby", `format-${format}`);
      if (!result.valid || !valid) { code.textContent = ""; return; }
      const settings = result.settings;
      const digits = previewDigits(settings);
      const dimensions = themes[settings.asset];
      strip.style.setProperty("--digit-count", String(digits.length));
      strip.style.setProperty("--digit-width", `${dimensions.width}px`);
      strip.setAttribute("aria-label", `${labels.preview}: ${digits}`);
      strip.replaceChildren(...[...digits].map(digit => {
        const image = document.createElement("img");
        image.src = digitImages[settings.asset][Number(digit)];
        image.alt = "";
        image.width = dimensions.width;
        image.height = dimensions.height;
        return image;
      }));
      size.textContent = `${dimensions.width * digits.length} × ${dimensions.height} px`;
      code.textContent = embedCode(settings, format, labels.alt);
    }
    form.addEventListener("input", render);
    form.addEventListener("change", render);
    form.addEventListener("submit", event => event.preventDefault());
    formatButtons.forEach(button => button.addEventListener("click", () => { format = button.dataset.format as Format; render(); }));
    formatButtons.forEach((button, index) => button.addEventListener("keydown", event => {
      let next: number;
      if (event.key === "ArrowRight") next = (index + 1) % formatButtons.length;
      else if (event.key === "ArrowLeft") next = (index - 1 + formatButtons.length) % formatButtons.length;
      else if (event.key === "Home") next = 0;
      else if (event.key === "End") next = formatButtons.length - 1;
      else return;
      event.preventDefault();
      formatButtons[next].focus();
      formatButtons[next].click();
    }));
    const previewSection = document.querySelector<HTMLElement>(".preview-section")!;
    new ResizeObserver(() => {
      document.documentElement.style.setProperty("--preview-height", `${previewSection.getBoundingClientRect().height}px`);
    }).observe(previewSection);
    // Keep keyboard focus outside the mobile sticky preview's occupied space.
    document.addEventListener("focusin", event => {
      const target = event.target;
      if (!(target instanceof HTMLElement) || previewSection.contains(target)) return;
      requestAnimationFrame(() => {
        if (getComputedStyle(previewSection).position !== "sticky") return;
        const previewRect = previewSection.getBoundingClientRect();
        const targetRect = target.getBoundingClientRect();
        if (targetRect.top < previewRect.bottom && targetRect.bottom > previewRect.top) {
          window.scrollBy({ top: targetRect.top - previewRect.bottom - 16, behavior: "instant" });
        }
      });
    });
    function selectCode() {
      const selection = window.getSelection();
      const range = document.createRange();
      range.selectNodeContents(code);
      selection?.removeAllRanges();
      selection?.addRange(range);
    }
    code.addEventListener("click", selectCode);
    async function copyCode(): Promise<string> {
      const currentRevision = revision;
      const value = code.textContent!;
      try {
        await navigator.clipboard.writeText(value);
        if (currentRevision !== revision) return "";
        copyButton.textContent = labels.copied;
        status.textContent = labels.copied;
        timer = setTimeout(() => { copyButton.textContent = labels.copy; status.textContent = ""; }, 2000);
        return labels.copied;
      } catch {
        if (currentRevision !== revision) return "";
        panel.focus({ preventScroll: true });
        selectCode();
        status.textContent = labels.selected;
        return labels.selected;
      }
    }
    copyButton.addEventListener("click", () => { void copyCode(); });

    const commandForm = document.querySelector<HTMLFormElement>("#command-form")!;
    const commandInput = document.querySelector<HTMLInputElement>("#command-input")!;
    const commandLog = document.querySelector<HTMLElement>("#command-log")!;
    const commandConsole = document.querySelector<HTMLDetailsElement>("#command-console")!;
    const completionPanel = document.querySelector<HTMLElement>("#command-completions")!;
    const completionStatus = document.querySelector<HTMLElement>("#command-completion-status")!;
    const completionButton = document.querySelector<HTMLButtonElement>("#command-complete")!;
    let lastCompletion = "";
    const history: string[] = [];
    let historyIndex = 0;
    let draft = "";
    function currentCommandState(): CommandState {
      return { asset: form.querySelector<HTMLInputElement>('[name="asset"]:checked')!.value as CommandState["asset"], offset: offset.validity.badInput ? "?" : offset.value, padding: padding.validity.badInput ? "?" : padding.value, format };
    }
    function appendCommandResult(text: string, isError = false, accessibleLabel?: string) {
      const output = document.createElement("pre");
      output.className = isError ? "command-response command-error" : "command-response";
      output.textContent = text;
      if (accessibleLabel) { output.setAttribute("role", "img"); output.setAttribute("aria-label", accessibleLabel); }
      commandLog.append(output);
      while (commandLog.children.length > 40) commandLog.firstElementChild?.remove();
      commandLog.scrollTop = commandLog.scrollHeight;
    }
    commandConsole.addEventListener("toggle", () => { if (commandConsole.open) commandInput.focus(); });
    function dismissCompletions() {
      completionPanel.hidden = true;
      completionPanel.replaceChildren();
      completionStatus.textContent = "";
      lastCompletion = "";
    }
    function setCommandLine(value: string, cursor = value.length) {
      commandInput.value = value;
      commandInput.setSelectionRange(cursor, cursor);
    }
    function requestCompletion(): boolean {
      const value = commandInput.value;
      const cursor = commandInput.selectionStart ?? value.length;
      const result = completeCommand(value, cursor);
      const signature = `${result.value}\n${result.cursor}`;
      // An unchanged second Tab leaves the field normally, rather than trapping focus.
      if (!result.candidates.length || signature === lastCompletion) return false;
      dismissCompletions();
      if (result.value.length > 1024) return false;
      setCommandLine(result.value, result.cursor);
      lastCompletion = signature;
      if (result.candidates.length === 1) {
        completionStatus.textContent = result.candidates[0];
      } else {
        completionPanel.hidden = false;
        result.candidates.forEach(candidate => {
          const button = document.createElement("button");
          button.type = "button";
          button.textContent = candidate;
          button.addEventListener("click", () => {
            const selected = insertCompletion(commandInput.value, commandInput.selectionStart ?? commandInput.value.length, candidate);
            if (selected.value.length > 1024) return;
            setCommandLine(selected.value, selected.cursor);
            dismissCompletions();
            commandInput.focus();
          });
          completionPanel.append(button);
        });
        completionStatus.textContent = `${result.candidates.length}${labels.commandCompletionCount}`;
      }
      return true;
    }
    completionButton.addEventListener("click", () => { lastCompletion = ""; requestCompletion(); commandInput.focus(); });
    commandInput.addEventListener("input", dismissCompletions);
    commandInput.addEventListener("click", dismissCompletions);
    completionPanel.addEventListener("keydown", event => {
      if (event.key === "Escape") { event.preventDefault(); dismissCompletions(); commandInput.focus(); }
    });
    commandInput.addEventListener("keydown", event => {
      if (event.isComposing) return;
      if (event.key === "Tab" && !event.shiftKey && !event.ctrlKey && !event.metaKey && !event.altKey) {
        if (requestCompletion()) event.preventDefault();
        return;
      }
      if (event.key === "Escape") { dismissCompletions(); return; }
      if (event.ctrlKey && !event.metaKey && !event.altKey) {
        const key = event.key.toLowerCase();
        const start = commandInput.selectionStart ?? 0;
        const end = commandInput.selectionEnd ?? start;
        if (key === "c" && start === end) {
          event.preventDefault();
          appendCommandResult(`guest@kauntah:~$ ${commandInput.value}^C`);
          setCommandLine("");
          draft = "";
          historyIndex = history.length;
          dismissCompletions();
          return;
        }
        if (key === "l") { event.preventDefault(); commandLog.replaceChildren(); dismissCompletions(); return; }
        if (["a", "e", "u", "k"].includes(key)) {
          event.preventDefault();
          dismissCompletions();
          if (key === "a") commandInput.setSelectionRange(0, 0);
          if (key === "e") commandInput.setSelectionRange(commandInput.value.length, commandInput.value.length);
          if (key === "u") setCommandLine(commandInput.value.slice(end), 0);
          if (key === "k") setCommandLine(commandInput.value.slice(0, start), start);
          return;
        }
      }
      if (["ArrowLeft", "ArrowRight", "Home", "End"].includes(event.key)) dismissCompletions();
      if (!["ArrowUp", "ArrowDown"].includes(event.key)) return;
      dismissCompletions();
      event.preventDefault();
      if (historyIndex === history.length) draft = commandInput.value;
      historyIndex = Math.max(0, Math.min(history.length, historyIndex + (event.key === "ArrowUp" ? -1 : 1)));
      commandInput.value = historyIndex === history.length ? draft : history[historyIndex];
      commandInput.setSelectionRange(commandInput.value.length, commandInput.value.length);
    });
    commandForm.addEventListener("submit", async event => {
      event.preventDefault();
      dismissCompletions();
      const input = commandInput.value.trim();
      if (!input) return;
      if (history.at(-1) !== input) history.push(input);
      if (history.length > 100) history.shift();
      historyIndex = history.length;
      draft = "";
      commandInput.value = "";
      appendCommandResult(`guest@kauntah:~$ ${input}`);
      const result = parseCommand(input, currentCommandState());
      if (result.kind === "error") { appendCommandResult(`kauntah: ${labels.commandErrors[result.error]}`, true); return; }
      if (result.kind === "steamTrain") { appendCommandResult(labels.commandTrain); runSteamTrain(); return; }
      if (result.kind === "uuid") {
        const uuid = crypto.randomUUID();
        appendCommandResult(uuid);
        if (result.copy) {
          try {
            await navigator.clipboard.writeText(uuid);
            appendCommandResult(labels.copied);
          } catch {
            appendCommandResult(labels.commandUuidCopyError, true);
          }
        }
        return;
      }
      if (result.kind === "cat") {
        appendCommandResult(String.raw` /\_/\
( o.o )  meow!
 > ^ <`, false, labels.commandCat);
        return;
      }
      if (result.kind === "help") { appendCommandResult(labels.commandUsage); return; }
      if (result.kind === "history") { appendCommandResult(history.map((entry, index) => `${String(index + 1).padStart(4)}  ${entry}`).join("\n")); return; }
      if (result.kind === "themes") { appendCommandResult(Object.keys(themes).join("\n")); return; }
      if (result.kind === "clear") {
        commandLog.replaceChildren();
        appendCommandResult(labels.commandCleared);
        return;
      }
      if (result.kind === "copy") {
        if (copyButton.disabled) { appendCommandResult(labels.commandInvalid, true); return; }
        const message = await copyCode();
        if (message) appendCommandResult(message);
        return;
      }
      if (result.kind === "update") {
        const radio = [...form.querySelectorAll<HTMLInputElement>('[name="asset"]')].find(control => control.value === result.state.asset)!;
        radio.checked = true;
        offset.value = result.state.offset;
        padding.value = result.state.padding;
        format = result.state.format;
        render();
      }
      const current = currentCommandState();
      appendCommandResult(describeCommandState(current));
      if (result.kind === "show") {
        if (copyButton.disabled) appendCommandResult(labels.commandInvalid, true);
        else appendCommandResult(code.textContent!);
      }
    });
    render();
  </script>
</BaseLayout>
